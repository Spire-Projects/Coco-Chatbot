# ============================================================
# Coco Chatbot — Variables de Entorno
# Copia este archivo a .env y rellena los valores
# ============================================================

# ── Meta WhatsApp Business Cloud API ────────────────────────
# Obtenlos en: https://developers.facebook.com > Tu App > WhatsApp > Configuracion API
META_ACCESS_TOKEN=PEGAR_TOKEN_PERMANENTE_DE_META
META_PHONE_NUMBER_ID=PEGAR_PHONE_NUMBER_ID_DE_META
META_WEBHOOK_VERIFY_TOKEN=coco_verify_token_secreto
META_API_VERSION=v21.0

# ── Google Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=AIzaSyAKjbsWynXGL7-o0F-vfihWBwMyG9JdXR0
GEMINI_MODEL=gemini-1.5-flash

# ── Google Sheets (directorio de empresas) ───────────────────
# El ID de tu spreadsheet: https://docs.google.com/spreadsheets/d/{ID}/edit
SHEETS_SPREADSHEET_ID=PEGAR_ID_DEL_SPREADSHEET
SHEETS_SHEET_NAME=Hoja1
SHEETS_RANGE=A1:H
SHEETS_CACHE_SECONDS=120

# ── Turso DB (almacena los prompts) ──────────────────────────
# Crea cuenta gratuita en: https://turso.tech
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu_token_de_turso

# ── Servidor ─────────────────────────────────────────────────
API_PORT=3100

# ── Configuracion opcional ───────────────────────────────────
MEMORY_TTL_MINUTES=30
TIMEZONE=America/La_Paz
LOG_LEVEL=info
